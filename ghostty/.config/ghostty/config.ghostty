theme = Catppuccin Mocha

font-family = "JetBrains Mono"
font-style = "Regular"
font-style-bold = "Bold"
font-style-italic = "Italic"
font-style-bold-italic = "Bold Italic"
font-size = 10

adjust-cell-height = 2

window-padding-x = 4
window-padding-y = 4
window-decoration = true
background-opacity = 0.9
